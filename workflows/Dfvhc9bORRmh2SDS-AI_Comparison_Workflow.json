{
  "name": "AI Comparison Workflow",
  "nodes": [
    {
      "id": "manual-trigger-1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -200,
        300
      ],
      "parameters": {}
    },
    {
      "id": "set-prompt-1",
      "name": "Set Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        50,
        300
      ],
      "parameters": {}
    },
    {
      "id": "google-gemini-1",
      "name": "Google Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        300,
        200
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-pro"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "={{ $json.text }}"
            }
          ]
        }
      },
      "credentials": {
        "googlePalmApi": {
          "id": "30DDnia40IbLh11L",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "id": "huggingface-1",
      "name": "HuggingFace",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        400
      ],
      "parameters": {
        "url": "[REDACTED]",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "inputs",
              "value": "={{ $('Set Prompt').item.json.text }}"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Set Prompt": {
      "main": [
        [
          {
            "node": "Google Gemini",
            "type": "main",
            "index": 0
          },
          {
            "node": "HuggingFace",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Set Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "saveExecutionProgress": true,
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "staticData": null,
  "pinData": {},
  "triggerCount": 0,
  "meta": null
}