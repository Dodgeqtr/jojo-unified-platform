        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"query\": \"{{$parameter.query}}\",\n  \"limit\": 3\n}",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{\n  \"Authorization\": \"Bearer fc-53dd0de5fe3e45dead19a270e952ec40\",\n  \"Content-Type\": \"application/json\"\n}"
      },
