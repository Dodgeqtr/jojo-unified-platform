# =========================================
# Jojo Unified Platform - Environment Variables
# =========================================

# ===== Server Configuration =====
PORT=3000
NODE_ENV=development
DEBUG=true

# ===== Database =====
# ملاحظة: داخل Docker Compose، استخدم postgres كاسم host بدل localhost
POSTGRES_DB=jojo_db
POSTGRES_USER=jojo_user
POSTGRES_PASSWORD=jojo_dev_password
DATABASE_URL=postgresql://jojo_user:jojo_dev_password@localhost:5432/jojo_db
REDIS_URL=redis://localhost:6379

# ===== n8n السحابي (Cloud) =====
N8N_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key
N8N_API_URL=https://your-instance.app.n8n.cloud

# ===== n8n المحلي (Local, عبر Docker) =====
N8N_LOCAL_API_URL=http://n8n-local:5678
N8N_LOCAL_WEBHOOK_URL=http://n8n-local:5678/webhook/jojo-local-agent
N8N_LOCAL_API_KEY=

# ===== الذكاء الاصطناعي (LLM) =====
# LLM_PROVIDER: ollama (محلي، أولوية) أو gemini أو anthropic
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ===== الواجهة الأمامية (Vite/Web) =====
VITE_API_URL=http://localhost
VITE_CRM_URL=http://localhost
VITE_N8N_URL=http://localhost

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_TOKEN=your_github_token

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret

# ===== Security =====
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRY=7d
ENCRYPTION_KEY=your_encryption_key

# ===== Email Configuration =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ===== Logging =====
LOG_LEVEL=debug
LOG_FORMAT=json

# ===== Features =====
ENABLE_WEBHOOKS=true
ENABLE_AUTOMATION=true
WEBHOOK_SECRET=your_webhook_secret

# ===== CORS =====
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ===== Other Services =====
HEYGEN_API_KEY=your_heygen_api_key
NOTION_API_KEY=your_notion_api_key
